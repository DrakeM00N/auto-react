PORT=3001
# REQUIRED — server refuses to start without it. Use 32+ random bytes.
JWT_SECRET=your_jwt_secret_here_change_in_production
LIQPAY_PUBLIC_KEY=your_liqpay_public_key_here
LIQPAY_PRIVATE_KEY=your_liqpay_private_key_here
# Set to "1" to use LiqPay sandbox, "0" (or unset) for real charges.
LIQPAY_SANDBOX=1
# Publicly reachable URL of THIS backend. Required for LiqPay to call
# /api/liqpay/callback after payment. In local dev, use an ngrok tunnel.
PUBLIC_BACKEND_URL=
FRONTEND_URL=http://localhost:5173
ANALYTICS_IP_SALT=change_this_to_a_long_random_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
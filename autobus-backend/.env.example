PORT=3001
# REQUIRED — server refuses to start without it. Use 32+ random bytes.
JWT_SECRET=your_jwt_secret_here_change_in_production

# monobank acquiring (Plata by mono). Get your token at https://web.monobank.ua/.
MONOBANK_TOKEN=your_monobank_acquiring_token_here

# Publicly reachable URL of THIS backend. Required for monobank to call
# /api/payments/webhook after payment. In local dev, use an ngrok tunnel.
BACKEND_PUBLIC_URL=

# Frontend origin(s) — comma-separated for multiple (e.g. localhost + LAN IP).
FRONTEND_URL=http://localhost:5173

# Salt for hashing visitor IPs in the analytics table.
ANALYTICS_IP_SALT=change_this_to_a_long_random_string

# Google OAuth web client ID for "Continue with Google".
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

PORT=3001
# REQUIRED — server refuses to start without it. Use 32+ random bytes.
JWT_SECRET=your_jwt_secret_here_change_in_production

# WayForPay acquiring (https://wayforpay.com/). Get credentials in the merchant cabinet.
WAYFORPAY_MERCHANT_ACCOUNT=your_merchant_account
WAYFORPAY_SECRET_KEY=your_wayforpay_secret_key
WAYFORPAY_MERCHANT_DOMAIN=your-domain.com

# Publicly reachable URL of THIS backend. Required for WayForPay to call
# /api/payments/webhook (serviceUrl) after payment. In local dev, use an ngrok tunnel.
BACKEND_PUBLIC_URL=

# Frontend origin(s) — comma-separated for multiple (e.g. localhost + LAN IP).
FRONTEND_URL=http://localhost:5173

# Salt for hashing visitor IPs in the analytics table.
ANALYTICS_IP_SALT=change_this_to_a_long_random_string

# Google OAuth web client ID for "Continue with Google".
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Comma-separated emails that should get role='admin' on FIRST registration
# (recovery path after a DB reset). Independent of the implicit first-user
# bootstrap — if the users table is empty, whoever registers first becomes
# admin regardless of this list. Existing users are NOT promoted by adding
# their email here.
ADMIN_EMAILS=

# Resend (https://resend.com) — transactional email for password reset.
# Without RESEND_API_KEY, /forgot-password still issues a token but the
# email isn't delivered; instead the reset link is dumped to backend stdout
# so you can test the flow locally. Useful in dev.
RESEND_API_KEY=
# Sender shown to the recipient. For first dev runs you can use the Resend
# sandbox sender, which only delivers to your Resend account email:
#   EMAIL_FROM='BusToRIA <onboarding@resend.dev>'
# For production, verify your own domain in the Resend dashboard and switch
# to noreply@your-domain.
EMAIL_FROM='BusToRIA <onboarding@resend.dev>'
